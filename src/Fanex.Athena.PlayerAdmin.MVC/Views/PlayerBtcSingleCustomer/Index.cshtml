@{
    ViewData["Title"] = ViewResources.BettingTicketCenter + " - " + ViewResources.SingleCustomer;
}

@using  Fanex.Athena.PlayerAdmin.Core.Settings;
@inject Microsoft.Extensions.Options.IOptions<AppSetting> setting
@inject Fanex.Athena.PlayerAdmin.Core.Services.IContextService contextService
@model PlayerBtcSingleCustomerViewModel

@{
    var now = DateTime.Now;
    var fromDate = new DateTime(now.Year, now.Month, 1).ToString("MM/dd/yyyy");
    var toDate = now.ToString("MM/dd/yyyy");

    const string TitlePattern = "{0}: {1}, {2}→{3}, {4}: {5}, {6}: {7}";
    var reportTitle = string.Format(TitlePattern,
        ViewResources.Player, Model.UserName,
        fromDate, toDate,
        ViewResources.Currency, Model.CurrencyName,
        ViewResources.Product, Model.ProductCodeListString);

    var accessToken = await contextService.AccessToken;
}

@section pagecss {
    <link href="~/css/betlist/index.css" rel="stylesheet" type="text/css" asp-append-version="true" />
    <link href="~/css/betlist/bettingticketscenter.css" rel="stylesheet" type="text/css" asp-append-version="true" />
    <style>
        .caret-block {
            bottom: 2px;
        }

            .caret-block .icon-excel-wrapper {
                margin-left: 10px;
                background: #fff;
                text-align: center;
                width: 24px;
                height: 22px;
            }

        #app-container {
            margin-top: 10px;
        }
    </style>
}

@section pagejs {
    <script src="~/js/single-customer.chunk.js" asp-append-version="true"></script>
    <script async src="@setting.Value.BetTicketEventBuilderUrl" id="event-builder-script"></script>
}

@section globaljscode {
    window.initialState = {
    isLoading: false,
    requestParam: {userName: '@Model.UserName'}
    };

    window._AppData = {
    access_token: '@accessToken',
    isAllowedCustomerComm: @Model.IsAllowedCustomerComm.ToString().ToLower(),
    reportTitle: '@Html.Raw(reportTitle)',
    isAllowTxIDColumn: @ViewBag.IsAllowTxIDColumn.ToString().ToLower()
    };
}
<div id="app-container">
</div>