@{
    ViewData["Title"] = ViewResources.BetListRunning;
}
@using  Fanex.Athena.PlayerAdmin.Infrastructure.Settings;
@inject Microsoft.Extensions.Options.IOptions<AppSetting> setting
@inject Fanex.Athena.PlayerAdmin.Infrastructure.Services.IContextService contextService
@model PlayerRunningBetListViewModel
@{
    var accessToken = await contextService.AccessToken;
}

@section pagecss {
    <environment include="Development">
        <link href="~/css/dev/betlist/index.css" rel="stylesheet" type="text/css" asp-append-version="true" />
        <link href="~/css/dev/running-betlist.css" rel="stylesheet" type="text/css" asp-append-version="true" />
    </environment>
    <environment exclude="Development">
        <link href="~/css/pro/betlist/index.css" rel="stylesheet" type="text/css" asp-append-version="true" />
        <link href="~/css/pro/running-betlist.css" rel="stylesheet" type="text/css" asp-append-version="true" />
    </environment>
    <script src="@setting.Value.BetTicketEventBuilderUrl" id="event-builder-script"></script>
}

@section pagejs {
    <environment include="Development">
        <script src="~/js/dev/runningbetlist.chunk.js" asp-append-version="true"></script>
    </environment>
    <environment exclude="Development">
        <script src="~/js/pro/runningbetlist.chunk.js" asp-append-version="true"></script>
    </environment>
}

@section globaljscode {
    window.initialState = {
    requestParam: { CustId: @Model.CustId, Currency: '@Model.Currency', PageIndex: 1, PageSize: 50 }
    };
    window._AppData = {
    access_token: '@accessToken',
    isAllowTxIDColumn: '@ViewBag.IsAllowTxIDColumn.ToString()' === 'True'
    };
}
<div id="app-container">
</div>
