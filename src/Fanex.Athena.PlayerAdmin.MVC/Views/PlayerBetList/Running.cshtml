@{
    ViewData["Title"] = ViewResources.BetListRunning;
}
@inject IOptions<AppSetting> setting
@inject IContextService contextService
@using Fanex.Athena.PlayerAdmin.Core.Settings
@using Microsoft.Extensions.Options
@model PlayerRunningBetListViewModel
@{
    var accessToken = await contextService.AccessToken;
}

@section pagecss {
    <link href="~/css/betlist/index.css" rel="stylesheet" type="text/css" asp-append-version="true" />
    <link href="~/css/running-betlist.css" rel="stylesheet" type="text/css" asp-append-version="true" />
}

@section pagejs {
    <script src="~/js/runningbetlist.chunk.js" asp-append-version="true"></script>
    <script async src="@setting.Value.BetTicketEventBuilderUrl" id="event-builder-script"></script>
}

@section globaljscode {
    window.initialState = {
    requestParam: { CustId: @Model.CustId, Currency: '@Model.Currency', PageIndex: 1, PageSize: 50 }
    };
    window._AppData = {
    access_token: '@accessToken',
    isAllowTxIDColumn: '@ViewBag.IsAllowTxIDColumn.ToString()' === 'True'
    };
}
<div id="app-container">
</div>
