@using Microsoft.AspNetCore.Mvc.ViewEngines
@inject IContextService ContextService;
@inject ICompositeViewEngine ViewEngineService;
@{
    ViewData["Title"] = ViewResources.CustomerWinLoss;
}

@{
    var defaultLang = "en-us";
    var lang = ContextService.Language;
    var partialView = $"{Model}/{lang}.cshtml";
    var path = ViewContext.View.Path;
    var viewResult = ViewEngineService.FindView(ViewContext, $"{Model}/{lang}", isMainPage: false);
    if (!viewResult.Success)
    {
        partialView = $"{Model}/{defaultLang}.cshtml";
    }
}

@section pagecss {
    <link href="~/css/userguide.css" rel="stylesheet" type="text/css" asp-append-version="true" />
}
@Html.Partial(partialView)