@{
    ViewData["Title"] = ViewResources.Statement;
}

@model PlayerStatementViewModel

@section pagecss {
    <environment include="Development">
        <link href="~/css/dev/statement.css" rel="stylesheet" type="text/css" asp-append-version="true" />
    </environment>
    <environment exclude="Development">
        <link href="~/css/pro/statement.css" rel="stylesheet" type="text/css" asp-append-version="true" />
    </environment>
}
@section pagejs {
    <environment include="Development">
        <script src="~/js/dev/statement.chunk.js" asp-append-version="true"></script>
    </environment>
    <environment exclude="Development">
        <script src="~/js/pro/statement.chunk.js" asp-append-version="true"></script>
    </environment>
}
@section globaljscode {
    window.initialState = {
    requestParam: { custId: @Model.CustId, currencyId: @Model.CurrencyId, fromDate: '@Model.FromDate.ToString("MM/dd/yyyy")', toDate: '@Model.ToDate.ToString("MM/dd/yyyy")' },
    };

    window._AppData = {
    dateConstraint: { minDate: '@Model.MinDate.ToString("MM/dd/yyyy")', maxDate: '@Model.ToDate.ToString("MM/dd/yyyy")' }
    };
}
<div id="app-container">
</div>
