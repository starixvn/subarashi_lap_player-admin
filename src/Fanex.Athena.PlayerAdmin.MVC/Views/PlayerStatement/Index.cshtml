@{
    ViewData["Title"] = ViewResources.Statement;
}

@model PlayerStatementViewModel

@section pagecss {
    <link href="~/css/statement.css" rel="stylesheet" type="text/css" asp-append-version="true" />
}
@section pagejs {
    <script src="~/js/statement.chunk.js" asp-append-version="true"></script>
}
@section globaljscode {
    window.initialState = {
    requestParam: { custId: @Model.CustId, currencyId: @Model.CurrencyId, fromDate: '@Model.FromDate.ToString("MM/dd/yyyy")', toDate: '@Model.ToDate.ToString("MM/dd/yyyy")' },
    };

    window._AppData = {
    dateConstraint: { minDate: '@Model.MinDate.ToString("MM/dd/yyyy")', maxDate: '@Model.MaxDate.ToString("MM/dd/yyyy")', limitedMonthRange: 2 }
    };
}
<div id="app-container">
</div>