@{
    ViewData["Title"] = ViewResources.DetailTransaction;
}

@model PlayerDetailTransactionReportViewModel

@section pagecss {
    <environment include="Development">
        <link href="~/css/dev/detailtransaction.css" rel="stylesheet" type="text/css" asp-append-version="true" />
    </environment>
    <environment exclude="Development">
        <link href="~/css/pro/detailtransaction.css" rel="stylesheet" type="text/css" asp-append-version="true" />
    </environment>
}
@section pagejs {
    <environment include="Development">
        <script src="~/js/dev/detailtransaction.chunk.js" asp-append-version="true"></script>
    </environment>
    <environment exclude="Development">
        <script src="~/js/pro/detailtransaction.chunk.js" asp-append-version="true"></script>
    </environment>
}
@section globaljscode {
    window.initialState = {
    requestParam: {
    CustId: @Model.CustId,
    CurrencyId: @Model.CurrencyId,
    FromDate: '@Model.FromDate.ToString("MM/dd/yyyy")',
    ToDate: '@Model.ToDate.ToString("MM/dd/yyyy")',
    PageSize: @Model.PageSize,
    PageIndex: @Model.PageIndex
    },
    isLoading: false
    };

    window._AppData = {
    dateConstraint: {
    minDate: '@Model.MinDate.ToString("MM/dd/yyyy")',
    maxDate: '@Model.ToDate.ToString("MM/dd/yyyy")'
    },
    defaultPageSize:  @Model.PageSize,
    defaultPageIndex: @Model.PageIndex
    };
}
<div id="app-container">
</div>
