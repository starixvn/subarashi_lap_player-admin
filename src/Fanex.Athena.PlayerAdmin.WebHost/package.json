  "scripts": {
    "stats": "node node_modules/webpack/bin/webpack.js --config www/webpackconfig/build/webpack.dev.conf.js --json > stats.json",
    "test": "node node_modules/karma/bin/karma start --reporters kjhtml,junit,dots,coverage",
    "test-new": "node node_modules/karma/bin/karma start karma-new.conf.js --reporters kjhtml,junit,dots,coverage",
    "test-new-bypage": "node node_modules/karma/bin/karma start karma-new-bypage.conf.js",
    "build-dev": "node node_modules/webpack/bin/webpack.js --config www/webpackconfig/build/webpack.dev.conf.js",
    "build-pro": "node node_modules/webpack/bin/webpack.js --config www/webpackconfig/build/webpack.pro.conf.js",
    "build-react-dev": "node node_modules/webpack/bin/webpack.js --config www/webpackconfig/build/webpack.react.dev.conf.js",
    "build-react-pro": "node node_modules/webpack/bin/webpack.js --config www/webpackconfig/build/webpack.react.pro.conf.js",
    "build-react-both": "node node_modules/webpack/bin/webpack.js --config www/webpackconfig/build/webpack.react.pro.conf.js && node node_modules/webpack/bin/webpack.js --config www/webpackconfig/build/webpack.react.dev.conf.js",
    "test-react": "node node_modules/jest/bin/jest.js --coverage",
    "test-react-one": "node node_modules/jest/bin/jest.js \".*1\\.test\\.js\" --watch --u",
    "test-react-watch": "node node_modules/jest/bin/jest.js --watch",
    "jest-install": "npm install jest-cli -g",
    "jest-uss": "node node_modules/jest/bin/jest.js --updateSnapshot",
    "lint": "eslint ./www/js/source/reactpages",
    "build-react-devbypage": "node node_modules/webpack/bin/webpack.js --config www/webpackconfig/build/webpack.react.devbypage.conf.js"
  },
