@model Fanex.Athena.PlayerAdmin.WebHost.Models.ErrorViewModel;

@{
    Layout = "_ErrorLayout";
    string errorMsg;
    switch (Model.Code)
    {
        case 400:
            errorMsg = ViewResources.InvalidRequestMsg;
            break;

        case 403:
            errorMsg = ViewResources.HttpError_403;
            break;

        case 404:
            errorMsg = ViewResources.HttpError_404;
            break;

        default:
            errorMsg = ViewResources.HttpError_Default;
            break;
    }
}

@section message{
    @errorMsg
}

