<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=0">
    <title>Error!!!!!</title>

    <style type="text/css">
        body {
            background: #fff;
        }

        .error-content {
            padding-top: 40px;
        }

        img {
            margin: 10px auto;
            display: block;
        }

        p {
            text-align: center;
            font-size: 18px;
            line-height: 20px;
        }

        .first-line {
            color: #0b3d6b;
            font-size: 45px;
        }

        .second-line {
            color: #545454;
        }

        .btn {
            display: inline-block;
            padding: 6px 12px;
            border-radius: 3px;
            font-size: 18px;
            text-decoration: none;
        }

        .btn-submit {
            background-color: #1C80F0;
            color: #fff;
        }
    </style>

    @RenderSection("head", false)
</head>
<body>
    <div class="error-content">
        <img src="~/images/robot.jpg" />
        <p class="first-line">Oops...</p>
        <p class="second-line">@RenderSection("message", false)</p>
        @RenderBody()
    </div>
</body>
</html>
