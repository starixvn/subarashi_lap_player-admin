@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers

@{
    Layout = null;
    var langCode = System.Globalization.CultureInfo.CurrentUICulture.IetfLanguageTag;
    var rootUrl = Url.Content("~");
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=0">
    <title>@ViewData["Title"] - Player Administration</title>
    <meta name="description" content="Player Administration" />
    <base href="@rootUrl" />
    <environment include="Development">
        <link href="~/css/dev/vendor.css" asp-append-version="true" rel="stylesheet" type="text/css" />
    </environment>
    <environment exclude="Development">
        <link href="~/css/pro/vendor.css" asp-append-version="true" rel="stylesheet" type="text/css" />
    </environment>
    @RenderSection("pagecss", required: false)
</head>
<body>
    @Html.AntiForgeryToken()
    <div class="wrapper">
        @RenderBody()
    </div>
    <script type="text/javascript">
        var PageLanguage = "@langCode";
        window.rootUrl = '@rootUrl';
        @RenderSection("globaljscode", required: false)
    </script>

    <environment include="Development">
        <script src="~/js/dev/lib/common.chunk.js" asp-append-version="true"></script>
        <script src="~/js/dev/lib/langHelper.chunk.js" asp-append-version="true"></script>
    </environment>
    <environment exclude="Development">
        <script src="~/js/pro/lib/common.chunk.js" asp-append-version="true"></script>
        <script src="~/js/pro/lib/langHelper.chunk.js" asp-append-version="true"></script>
    </environment>

    @if (langCode != "en-US")
    {
        <environment exclude="Development">
            @{
                var langDevLink = "~/js/build/dev/lib/lang-" + langCode + ".chunk.js";
                <script src="@langDevLink" asp-append-version="true"></script>
            }
        </environment>
        <environment exclude="Development">
            @{
                var langProLink = "~/js/build/pro/lib/lang-" + langCode + ".chunk.js";
                <script src="@langProLink" asp-append-version="true"></script>
            }
        </environment>
    }

    @await RenderSectionAsync("pagejs", required: false)
</body>
</html>
