@{
    ViewData["Title"] = ViewResources.BetLimit;
}
@model PlayerBetLimitProductViewModel

@{
    var productList = Model.ProductList.Select(c => new { value = c.Key, label = c.Value }).ToList();
}

@section pagecss {
    <link href="~/css/betlimit.css" rel="stylesheet" type="text/css" asp-append-version="true" />
}

@section pagejs {
    <script src="~/js/betlimit.chunk.js" asp-append-version="true"></script>
}

@section globaljscode {
    window.initialState = {
    requestParam: { CustId: @Model.CustId, ProductId: @Model.ProductId, CurrencyId: @Model.CurrencyId, LicenseeCustId: @Model.LicenseeCustId }
    };
    window._AppData = {
    productList:  @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(productList))
    };
}
<div id="app-container">
</div>