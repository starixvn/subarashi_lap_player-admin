@{
    ViewData["Title"] = ViewResources.BetLimit;
}
@using Fanex.Athena.PlayerAdmin.Infrastructure.Helpers;

@model PlayerBetLimitProductViewModel

@{
    var productList = Model.ProductList.Select(c => new { value = c.Key, label = c.Value }).ToList();
}

@section pagecss {
    <environment include="Development">
        <link href="~/css/dev/betlimit.css" rel="stylesheet" type="text/css" asp-append-version="true" />

    </environment>
    <environment exclude="Development">
        <link href="~/css/pro/betlimit.css" rel="stylesheet" type="text/css" asp-append-version="true" />
    </environment>
}

@section pagejs {
    <environment include="Development">
        <script src="~/js/dev/betlimit.chunk.js" asp-append-version="true"></script>
    </environment>
    <environment exclude="Development">
        <script src="~/js/pro/betlimit.chunk.js" asp-append-version="true"></script>
    </environment>
}

@section globaljscode {
    window.initialState = {
    requestParam: { CustId: @Model.CustId, ProductId: @Model.ProductId, CurrencyId: @Model.CurrencyId, LicenseeCustId: @Model.LicenseeCustId }
    };
    window._AppData = {
    productList:  @Html.Raw(productList.ToJson())
    };
}
<div id="app-container">
</div>
